pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    cd ./frontend
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd ./frontend
                    test -f ./node_modules/index.html
                '''
                sh '''
                    npm test -- --watchAll=false --coverage
                '''
            }
        }
        
    }
}
