pipeline {
    agent any
    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:24-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    cd ./frontend
                    npm ci
                    npm run build
                '''
            }
        }

        stage('Test') {
            agent {
                docker {
                    image 'node:24-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    cd ./frontend
                    npm test -- --watchAll=false --coverage
                '''
            }
        }

        stage('Deploy') {
            agent {
                docker {
                    image 'node:24-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    npm install -g netlify-cli
                    netlify --version
                '''
            }
        }
    }

    post {
        always {
            junit 'frontend/reports/junit.xml'
        }
    }
}
