pipeline {
    agent any
    stages {
        stage('Debug Dependencies') {
            steps {
                sh '''
                    echo "===== LOCATION ====="
                    pwd

                    echo "===== GIT ====="
                    git rev-parse HEAD
                    git log -1 --oneline

                    cd ./frontend

                    echo "===== PACKAGE.JSON ====="
                    grep -n '"typescript"' package.json || true
                    grep -n '"react-router-dom"' package.json || true

                    echo "===== PACKAGE-LOCK ====="
                    grep -n '"typescript"' package-lock.json | head -10 || true
                    grep -n '"yaml"' package-lock.json | tail -10 || true

                    echo "===== NODE/NPM ====="
                    node --version
                    npm --version
                '''
            }
        }
        stage('Build') {
            agent {
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    cd ./frontend
                    ls -la
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    ls -la
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd ./frontend
                    test -f ./node_modules/index.html
                '''
                sh '''
                    npm test -- --watchAll=false --coverage
                '''
            }
        }
        
    }
}
